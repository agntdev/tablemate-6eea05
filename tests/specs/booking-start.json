[
  {
    "name": "Reserve table",
    "steps": [
      {
        "expect": [
          {
            "method": "editMessageText",
            "payload": {
              "text": "When would you like to visit?"
            }
          }
        ],
        "send": {
          "callback": "booking:start"
        }
      }
    ]
  },
  {
    "name": "Guest reaches reservation confirmation",
    "steps": [
      { "send": { "callback": "booking:start" }, "expect": [{ "method": "editMessageText", "payload": { "text": "When would you like to visit?" } }] },
      { "send": { "callback": "booking:date:2026-09-21" }, "expect": [{ "method": "editMessageText", "payload": { "text": "Here are the open times for 2026-09-21:" } }] },
      { "send": { "callback": "booking:time:11:00" }, "expect": [{ "method": "editMessageText", "payload": { "text": "How many guests should I book for?" } }] },
      { "send": { "callback": "booking:party:2" }, "expect": [{ "method": "sendMessage", "payload": { "text": "Send a phone number, or type skip if you’d rather not share one." } }] },
      { "send": { "text": "skip" }, "expect": [{ "method": "sendMessage", "payload": { "text": "What name should I put on the reservation? Type skip if you’d rather not say." } }] },
      { "send": { "text": "skip" }, "expect": [{ "method": "sendMessage" }] }
    ]
  }
]
